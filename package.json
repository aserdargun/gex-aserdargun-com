{
  "name": "gex-aserdargun-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5296 --strictPort",
    "dev:codex": "node tools/preview.mjs start",
    "stop:local": "node tools/preview.mjs stop",
    "build": "tsc -b && vite build && node tools/static-routes.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "test": "vitest run",
    "lint": "eslint src tools tests vite.config.ts",
    "validate:codex": "npm run lint && npm test && npm run build && git diff --check",
    "assets:blender": "python3 tools/build-assets.py",
    "build:atlas": "VITE_ATLAS_DEEP_LINKS=true npm run build && node tools/stage-atlas.mjs",
    "build:azure": "npm run build && node tools/stage-azure.mjs && node tools/verify-azure.mjs",
    "verify:azure": "node tools/verify-azure.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.18"
  }
}
